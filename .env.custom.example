# =============================================================================
# hiring-agent（custom 分支）的 .env 範本
#   cp .env.custom.example .env   然後只填【必填】的項目
#   詳細說明：docs/custom-usage.md（括號裡是章節編號）
#   留空（KEY=）等同沒設定。路徑一律相對於 repo 根目錄。
# =============================================================================

# --- 評分用的 model（judge）(§5) ----------------------------------------------
# 每次執行都可以用 batch.py --provider / --model 覆蓋。
# provider 可選：openrouter | llamacpp | ollama | gemini | anthropic
LLM_PROVIDER=openrouter
# 【必填】OpenRouter 的 model id，到 https://openrouter.ai/models 挑一個支援
# structured outputs 的，例如 google/gemini-2.5-flash、qwen/qwen3-235b-a22b-2507
DEFAULT_MODEL=google/gemini-2.5-flash

# --- 抽取用的 model（OCR 後轉成 Extracted Resume）(§5) -----------------------
# 留空 = 沿用上面的 LLM_PROVIDER / DEFAULT_MODEL。
# 想比較不同 judge 時，建議把這裡固定下來，讓每個 judge 看到同一份 Extracted Resume。
# 注意：換這裡的 model 不會自動重抽，要重抽請加 --re-extract。
EXTRACTION_PROVIDER=
EXTRACTION_MODEL=
# off = 關掉 model 的思考階段（OpenRouter 的 reasoning 參數），抽取和評分分開設定。
# 推理型 model（例如 deepseek/deepseek-v4-flash-0731）在低溫度下有時會想不停：
# 實測 150 秒吐了 16 萬字思考還沒給答案，看起來就像卡住；關掉後同樣的請求約 2 秒。
# 只能用在支援 reasoning 的 model；不支援的 model 加了這個參數，OpenRouter 會回 404。
# 留空 = 不送（model 自己決定要不要思考）。
EXTRACTION_REASONING=off
JUDGE_REASONING=off

# 單次 LLM 呼叫的總時限（秒，含 upstream 的重試）。卡住的請求超時後算該份 Resume 失敗。
# 留空 = 90；本機小 model 或推理型 model 很慢時可以調高。
LLM_TIMEOUT=

# --- API keys / endpoints ----------------------------------------------------
# 【必填，若用 openrouter】https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# 用 llamacpp 時才需要；留空 = http://localhost:8080/v1
LLAMACPP_BASE_URL=
# 只有用 gemini provider 時才需要
GEMINI_API_KEY=

# GitHub token (§4)。留空時，如果已經 gh auth login，會自動用 `gh auth token`。
# 兩者都沒有的話，每小時只有 60 次請求，批次很快就用完。
GITHUB_TOKEN=

# --- Google Drive (§3) -------------------------------------------------------
# 【必填，若用 --source gdrive】和 cv-agent 的 .env 裡的 GDRIVE_FOLDER_ID 相同
GDRIVE_FOLDER_ID=
# 以下保持預設即可（client_secret.json 已經複製到 credentials/）
# GOOGLE_OAUTH_CLIENT_SECRET=credentials/client_secret.json
# GOOGLE_OAUTH_TOKEN=credentials/token.json

# --- SQLite store ------------------------------------------------------------
# STORE_PATH=data/hiring_agent.sqlite
